# Copy to /opt/dreammaker/app.env; keep it private and fill values on Ubuntu.
# Retain the existing secret when transferring your account database.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://dreammaker.hexloop.cc
INVITATION_PHRASE=
INVITATION_EMOJI_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
OPENROUTER_REASONING_EFFORT=default
OPENROUTER_MAX_COMPLETION_TOKENS=8192
YOUTUBE_PROVIDER=auto
YOUTUBE_API_KEY=
FREESOUND_API_KEY=
WIKIMEDIA_USER_AGENT=EmojiDreamMaker (mailto:YOUR_PUBLIC_CONTACT)
