# Optional. Wikipedia and public-domain art work without credentials.
# auto: yt-dlp first, optional Data API fallback. Other modes: yt-dlp, api.
YOUTUBE_PROVIDER=auto
# Install yt-dlp on PATH, or point to an official executable (e.g. ./.tools/yt-dlp).
YTDLP_PATH=
# Faster reusable worker: absolute path to the official Unix yt-dlp zip executable.
# Requires Python 3; keep scripts/ytdlp-worker.py available on the server.
YTDLP_PYTHON_ARCHIVE=
# Optional Python executable; default python3.
YTDLP_PYTHON=
# Optional persistent metadata directory; default .cache/youtube. Set off to disable.
YOUTUBE_CACHE_DIR=
# Optional; only used for fallback in auto or when YOUTUBE_PROVIDER=api.
YOUTUBE_API_KEY=
FREESOUND_API_KEY=
# GIPHY's Search API runs in the browser; this is a public integration key.
NEXT_PUBLIC_GIPHY_API_KEY=
# Identify this personal app to Wikimedia (provide your own contact URL/email).
# Replace with your real public contact; the example address is not a contact.
WIKIMEDIA_USER_AGENT="EmojiDreamMaker/0.2 (mailto:YOUR_PUBLIC_CONTACT)"
