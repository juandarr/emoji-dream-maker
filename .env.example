# Optional. Wikipedia and public-domain art work without credentials.
# auto: yt-dlp first, optional Data API fallback. Other modes: yt-dlp, api.
YOUTUBE_PROVIDER=auto
# Install yt-dlp on PATH, or point to an official executable (e.g. ./.tools/yt-dlp).
YTDLP_PATH=
# Faster reusable worker: absolute path to the official Unix yt-dlp zip executable.
# Requires Python 3; keep scripts/ytdlp-worker.py available on the server.
YTDLP_PYTHON_ARCHIVE=
# Optional Python executable; default python3.
YTDLP_PYTHON=
# Optional persistent metadata directory; default .cache/youtube. Set off to disable.
YOUTUBE_CACHE_DIR=
# Optional; only used for fallback in auto or when YOUTUBE_PROVIDER=api.
YOUTUBE_API_KEY=
FREESOUND_API_KEY=
# GIPHY's Search API runs in the browser; this is a public integration key.
NEXT_PUBLIC_GIPHY_API_KEY=
# Identify this personal app to Wikimedia (provide your own contact URL/email).
# Replace with your real public contact; the example address is not a contact.
WIKIMEDIA_USER_AGENT="EmojiDreamMaker/0.2 (mailto:YOUR_PUBLIC_CONTACT)"

# Optional Playground text generation. Private: never use NEXT_PUBLIC_ for this key.
OPENROUTER_API_KEY=
# Default is OpenRouter's free-model router. Choose a text model available to your account.
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated allowlist shown in the Playground's model picker.
# If set, takes precedence over OPENROUTER_MODEL. Paid models spend your credits.
OPENROUTER_MODELS=

# Optional reasoning effort: default, low, medium, high (model must support it).
OPENROUTER_REASONING_EFFORT=default
# Total completion budget, including reasoning; bounded to 1024–16384.
OPENROUTER_MAX_COMPLETION_TOKENS=8192

# Phase 2 accounts: required before the server starts.
# Generate a private secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Exact app origin. Local development can use http://127.0.0.1:3001; deployment requires HTTPS.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Absolute path on persistent local disk, outside the deployed checkout.
ACCOUNT_DB_PATH=
# Private invitation; phrase comparison ignores case and repeated whitespace.
INVITATION_PHRASE=
# Catalog ID, e.g. 1F419 for octopus. Do not set this to the glyph itself.
INVITATION_EMOJI_ID=
